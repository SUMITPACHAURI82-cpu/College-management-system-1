    <script>
        // --- Mobile Menu Toggle ---
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // --- Course Switcher Tabs ---
        function switchCourse(courseKey) {
            document.querySelectorAll('.course-tab').forEach(btn => {
                btn.className = 'course-tab px-6 py-3 rounded-xl font-bold text-sm glass-card text-slate-300 hover:text-white transition-all';
            });
            document.querySelectorAll('.course-content-block').forEach(block => block.classList.add('hidden'));

            document.getElementById(`tab-${courseKey}`).className = 'course-tab px-6 py-3 rounded-xl font-bold text-sm bg-edu-600 text-white shadow-lg transition-all';
            document.getElementById(`course-${courseKey}`).classList.remove('hidden');

            // Sync calculator selector
            document.getElementById('calc-course-select').value = courseKey;
            updateCourseComparison();
        }

        // --- Interactive Course Comparison & Fee Estimator ---
        const courseData = {
            bca: { baseTuition: 85000, avgPkg: "₹5.8 LPA", focus: "Software Dev, Web Apps, Database SQL, Coding" },
            bba: { baseTuition: 78000, avgPkg: "₹5.2 LPA", focus: "Corporate Finance, Marketing, HRM, Business Strategy" },
            bsc: { baseTuition: 72000, avgPkg: "₹5.5 LPA", focus: "Theoretical CS, Algorithms, Computer Architecture, Math" }
        };

        function updateCourseComparison() {
            const courseKey = document.getElementById('calc-course-select').value;
            const hostelOpt = document.getElementById('calc-hostel-select').value;
            const scholarshipPct = parseInt(document.getElementById('calc-scholarship-select').value);

            const selected = courseData[courseKey];
            let tuition = selected.baseTuition;
            let hostelAdd = 0;

            if (hostelOpt === 'hostel') hostelAdd = 45000;
            if (hostelOpt === 'bus') hostelAdd = 15000;

            const savings = (tuition * scholarshipPct) / 100;
            const netTuition = tuition - savings + hostelAdd;

            document.getElementById('res-tuition').innerText = `₹${(tuition + hostelAdd).toLocaleString('en-IN')}`;
            document.getElementById('res-savings').innerText = `₹${savings.toLocaleString('en-IN')} / yr`;
            document.getElementById('res-total').innerText = `₹${netTuition.toLocaleString('en-IN')}`;

            document.getElementById('comp-focus').innerHTML = `<i class="fa-solid fa-bullseye text-edu-500 mr-1.5"></i> <b>Core Focus:</b> ${selected.focus}`;
            document.getElementById('comp-avg').innerHTML = `<i class="fa-solid fa-chart-line text-emerald-400 mr-1.5"></i> <b>Avg Campus Package:</b> ${selected.avgPkg}`;
        }

        // --- Student Portal Simulator Switcher ---
        function switchPortalTab(tabKey) {
            document.querySelectorAll('.portal-tab-btn').forEach(btn => {
                btn.className = 'portal-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:text-white';
            });
            document.querySelectorAll('.portal-section').forEach(sec => sec.classList.add('hidden'));

            document.getElementById(`ptab-${tabKey}`).className = 'portal-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-edu-600 text-white';
            document.getElementById(`psec-${tabKey}`).classList.remove('hidden');

            if (tabKey === 'attendance' && !window.chartInitialized) {
                initAttendanceChart();
            }
        }

        function initAttendanceChart() {
            window.chartInitialized = true;
            const ctx = document.getElementById('attendanceChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Classes Attended', 'Absences'],
                    datasets: [{
                        data: [88.5, 11.5],
                        backgroundColor: ['#10b981', '#334155'],
                        borderWidth: 0
                    }]
                },
                options: {
                    plugins: {
                        legend: { display: false }
                    },
                    cutout: '75%'
                }
            });
        }

        // --- Modal & Form Handlers ---
        function openLoginModal() {
            document.getElementById('login-modal').classList.remove('hidden');
        }

        function closeLoginModal() {
            document.getElementById('login-modal').classList.add('hidden');
        }

        function setRole(role) {
            document.querySelectorAll('#login-modal button[id^="role-"]').forEach(b => {
                b.className = 'flex-1 py-2 rounded-lg text-slate-400 hover:text-white';
            });
            document.getElementById(`role-${role}`).className = 'flex-1 py-2 rounded-lg bg-edu-600 text-white';
        }

        function handlePortalLogin(e) {
            e.preventDefault();
            alert("Redirecting to active student/faculty session dashboard...");
            closeLoginModal();
        }

        function handleAdmissionSubmit(e) {
            e.preventDefault();
            alert("Application Submitted Successfully! Admission counsellor will contact you within 24 hours.");
            e.target.reset();
        }

        function simulateDownload() {
            alert("Downloading selected course material PDF...");
        }

        function toggleFaq(btn) {
            const answer = btn.nextElementSibling;
            const icon = btn.querySelector('i');
            const isOpen = !answer.classList.contains('hidden');

            document.querySelectorAll('.faq-answer').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('#faq-accordion i').forEach(el => el.style.transform = 'rotate(0deg)');

            if (!isOpen) {
                answer.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
            }
        }

        // Initial setup on window load
        window.onload = function() {
            updateCourseComparison();
        };
    </script>
</body>
</html>
